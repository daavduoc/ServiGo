FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml ./
RUN mvn dependency:go-offline -B || true
COPY src ./src
RUN mvn -B -DskipTests clean package

FROM eclipse-temurin:21-jre AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends --fix-missing \
      ca-certificates apt-utils \
      libgomp1 libglib2.0-0 libsm6 libxext6 libxrender1 libgl1 \
      libgtk2.0-0 libjpeg62-turbo libpng16-16 libtbb2 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/target/servigo-0.0.1-SNAPSHOT.jar ./app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-Xmx1g", "-jar", "app.jar"]